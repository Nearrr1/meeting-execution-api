generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_EMAIL    @map("pending_email")
  ACTIVE           @map("active")
  DISABLED         @map("disabled")
  DELETION_PENDING @map("deletion_pending")
  DELETED          @map("deleted")

  @@map("account_status")
}

enum ChallengePurpose {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RECOVERY  @map("password_recovery")

  @@map("challenge_purpose")
}

enum DeletionRequestStatus {
  SCHEDULED @map("scheduled")
  COMPLETED @map("completed")

  @@map("deletion_request_status")
}

model Account {
  id                  String                  @id @default(uuid()) @db.Uuid
  displayName         String                  @map("display_name")
  status              AccountStatus           @default(PENDING_EMAIL)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?               @map("deleted_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?               @map("deletion_requested_at") @db.Timestamptz(6)
  purgeAt             DateTime?               @map("purge_at") @db.Timestamptz(6)
  personalSpace       PersonalSpace?
  emails              AccountEmail[]
  localCredential     LocalCredential?
  challenges          AuthChallenge[]
  sessions            AuthSession[]
  federatedIdentities FederatedIdentity[]
  auditEvents         SecurityAuditEvent[]
  emailChangeRequests EmailChangeRequest[]
  oidcTransactions    OidcTransaction[]
  deletionRequest     AccountDeletionRequest?

  @@map("accounts")
}

model AccountDeletionRequest {
  id          String                @id @default(uuid()) @db.Uuid
  accountId   String                @unique @map("account_id") @db.Uuid
  requestedAt DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  purgeAt     DateTime              @map("purge_at") @db.Timestamptz(6)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(6)
  status      DeletionRequestStatus @default(SCHEDULED)
  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, purgeAt])
  @@map("account_deletion_requests")
}

model PersonalSpace {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("personal_spaces")
}

model AccountEmail {
  id                String          @id @default(uuid()) @db.Uuid
  accountId         String          @map("account_id") @db.Uuid
  addressSubmitted  String          @map("address_submitted")
  addressNormalized String          @unique @map("address_normalized")
  verifiedAt        DateTime?       @map("verified_at") @db.Timestamptz(6)
  isPrimary         Boolean         @default(true) @map("is_primary")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  challenges        AuthChallenge[]

  @@index([accountId, isPrimary])
  @@map("account_emails")
}

model LocalCredential {
  accountId    String   @id @map("account_id") @db.Uuid
  passwordHash String   @map("password_hash")
  changedAt    DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model AuthChallenge {
  id             String           @id @default(uuid()) @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  emailId        String           @map("email_id") @db.Uuid
  purpose        ChallengePurpose
  verifierDigest String           @map("verifier_digest") @db.Char(64)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int              @default(0) @map("failed_attempts")
  consumedAt     DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email          AccountEmail     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model AuthSession {
  id                String            @id @default(uuid()) @db.Uuid
  accountId         String            @map("account_id") @db.Uuid
  tokenHash         String            @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime          @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime          @map("absolute_expires_at") @db.Timestamptz(6)
  reauthenticatedAt DateTime?         @map("reauthenticated_at") @db.Timestamptz(6)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(6)
  userAgentLabel    String?           @map("user_agent_label")
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  oidcTransactions  OidcTransaction[]

  @@index([accountId, revokedAt])
  @@map("auth_sessions")
}

model FederatedIdentity {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  issuer                String
  subject               String
  provider              String
  providerEmail         String?  @map("provider_email")
  providerEmailVerified Boolean  @default(false) @map("provider_email_verified")
  linkedAt              DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([accountId])
  @@map("federated_identities")
}

model OidcTransaction {
  id                 String       @id @default(uuid()) @db.Uuid
  stateHash          String       @unique @map("state_hash") @db.Char(64)
  browserBindingHash String       @map("browser_binding_hash") @db.Char(64)
  provider           String
  intent             String
  accountId          String?      @map("account_id") @db.Uuid
  sessionId          String?      @map("session_id") @db.Uuid
  secretCiphertext   String       @map("secret_ciphertext")
  returnTo           String       @map("return_to")
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt         DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  account            Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  session            AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([accountId, sessionId])
  @@map("oidc_transactions")
}

model RateLimitEvent {
  id               BigInt   @id @default(autoincrement())
  scope            String
  identifierDigest String   @map("identifier_digest") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([scope, identifierDigest, createdAt])
  @@map("rate_limit_events")
}

model EmailQuotaWindow {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("email_quota_windows")
}

model EmailChangeRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String    @map("account_id") @db.Uuid
  newEmailSubmitted      String    @map("new_email_submitted")
  newEmailNormalized     String    @map("new_email_normalized")
  pendingEmailNormalized String?   @unique @map("pending_email_normalized")
  tokenHash              String    @map("token_hash") @db.Char(64)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, consumedAt, createdAt])
  @@index([expiresAt])
  @@map("email_change_requests")
}

model SecurityAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  eventType String   @map("event_type")
  outcome   String
  requestId String   @map("request_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("security_audit_events")
}
