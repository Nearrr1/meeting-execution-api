# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_execution?schema=public
PORT=3000
WEB_ORIGINS=http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password
EMAIL_CHANGE_URL=http://localhost:3001/confirm-email-change
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=AI Meeting Execution <no-reply@example.com>
OTP_HMAC_KEY=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=aimeeting_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Optional Auth0 OIDC settings. Configure all values together after provider setup approval.
# AUTH0_ISSUER=https://your-tenant.auth0.com/
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_CALLBACK_URL=http://localhost:3000/api/v1/auth/oidc/callback
# AUTH0_GOOGLE_CONNECTION=google-oauth2
# AUTH0_MICROSOFT_CONNECTION=your-entra-connection
# OIDC_TRANSACTION_ENCRYPTION_KEY=exactly-32-random-bytes-here!!
